---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  tags: string[];
  url: string;
}

const { title, excerpt, date, tags, url } = Astro.props;
---

<article class="group relative flex flex-col items-start bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md hover:border-blue-100 dark:hover:border-slate-600 transition-all duration-300">
  <div class="flex items-center gap-x-4 text-xs mb-4">
    <time datetime={date} class="text-slate-500 dark:text-slate-400">
      {date}
    </time>
    <div class="flex gap-2">
      {tags.map(tag => (
        <a href={`/tags/${tag}`} class="relative z-10 rounded-full bg-slate-100 dark:bg-slate-700 px-3 py-1.5 font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">
          {tag}
        </a>
      ))}
    </div>
  </div>
  <div class="group relative">
    <h3 class="mt-3 text-lg font-semibold leading-6 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
      <a href={url}>
        <span class="absolute inset-0"></span>
        {title}
      </a>
    </h3>
    <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
      {excerpt}
    </p>
  </div>
</article>
